{
  "name": "@zapz/sdk",
  "version": "0.1.4",
  "description": "Official Node.js / TypeScript SDK for the ZapZ WhatsApp API",
  "license": "MIT",
  "homepage": "https://zapz.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zapz-api/zapz-sdk.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/zapz-api/zapz-sdk/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.mts",
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "esm",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "whatsapp",
    "api",
    "zapz",
    "sdk",
    "baileys"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
