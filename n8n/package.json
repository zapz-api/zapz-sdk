{
  "name": "@zapz/n8n-nodes-zapz",
  "version": "0.2.0",
  "description": "n8n nodes for the ZapZ WhatsApp API: send messages, manage instances, groups and webhooks, and trigger workflows on WhatsApp events",
  "license": "MIT",
  "author": {
    "name": "ZapZ",
    "email": "admin@zapz.dev",
    "url": "https://zapz.dev"
  },
  "homepage": "https://zapz.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zapz-api/zapz-sdk.git",
    "directory": "n8n"
  },
  "bugs": {
    "url": "https://github.com/zapz-api/zapz-sdk/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "whatsapp",
    "zapz"
  ],
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');for(const d of ['nodes/ZapZ','nodes/ZapZTrigger','credentials'])for(const f of ['zapz.svg','zapz.dark.svg'])fs.copyFileSync(d+'/'+f,'dist/'+d+'/'+f)\"",
    "test": "node --test test/*.test.js"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZapZApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZapZ/ZapZ.node.js",
      "dist/nodes/ZapZTrigger/ZapZTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "n8n-workflow": "^2.16.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
